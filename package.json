{
  "name": "radio-lingo-monorepo",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @radio-lingo/mobile start",
    "web": "yarn workspace @radio-lingo/web dev",
    "build:web": "yarn workspace @radio-lingo/web build"
  }
}
